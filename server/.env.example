# Copy to .env and fill in from Neon (Connect button)
DATABASE_URL=
DIRECT_URL=

# Password for the sample people that npx prisma db seed adds (development only)
SEED_PASSWORD=

# Signs the log-in cookies. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The code people need to sign up. Leave it empty to close sign-up.
SIGNUP_CODE=